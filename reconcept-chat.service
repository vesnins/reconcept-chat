[Unit]
Description=Reconcept site chat bridge (Telegram)
After=network-online.target
Wants=network-online.target

[Service]
EnvironmentFile=/opt/reconcept-chat/.env
ExecStart=/usr/bin/python3 -u /opt/reconcept-chat/bridge.py
Restart=always
RestartSec=10
DynamicUser=yes
StateDirectory=reconcept-chat
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
MemoryMax=64M

[Install]
WantedBy=multi-user.target
